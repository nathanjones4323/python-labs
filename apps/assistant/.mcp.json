{
  "mcpServers": {
    "campsite-booker": {
      "command": "uv",
      "args": [
        "run", "--directory", "../campsite-booker",
        "--package", "campsite-booker", "campsite-booker-mcp"
      ]
    },
    "date-planner": {
      "command": "uv",
      "args": ["run", "--directory", "../date-planner", "date-planner-mcp"]
    },
    "garmin": {
      "command": "uvx",
      "args": [
        "--python", "3.12",
        "--from", "git+https://github.com/nathanjones4323/garmin_mcp@local/combined",
        "garmin-mcp"
      ],
      "env": {
        "GARMINTOKENS": "~/.config/garmin-mcp/tokens"
      }
    },
    "pay-my-bills": {
      "command": "uv",
      "args": [
        "run", "--directory", "../pay-my-bills",
        "--package", "pay-my-bills", "pay-my-bills-mcp"
      ]
    },
    "tee-time-booker": {
      "command": "uv",
      "args": [
        "run", "--directory", "../tee-time-booker",
        "--package", "tee-time-booker", "--extra", "mcp",
        "python", "-m", "tee_time_booker.mcp", "--cards"
      ]
    }
  }
}
