{
  "enabledPlugins": {
    "telegram@python-labs": true
  },
  "enabledMcpjsonServers": ["campsite-booker", "date-planner", "garmin", "pay-my-bills", "tee-time-booker"],
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "mcp__claude_ai_Google_Calendar__delete_event",
      "mcp__claude_ai_Gmail__send_message",
      "mcp__claude_ai_Gmail__reply",
      "mcp__claude_ai_Gmail__forward"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/memory_only.py\" \"${CLAUDE_PROJECT_DIR}\""
          }
        ]
      },
      {
        "matcher": "Bash|mcp__tee-time-booker__.*|mcp__campsite-booker__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/payment_guard.py\""
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/telegram_progress.py\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
