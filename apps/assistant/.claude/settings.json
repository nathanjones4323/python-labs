{
  "enabledMcpjsonServers": ["date-planner", "garmin", "tee-time-booker"],
  "permissions": {
    "allow": [
      "Read(./memory/**)",
      "Edit(./memory/**)",
      "WebSearch",
      "WebFetch",

      "mcp__date-planner__ping",
      "mcp__date-planner__list_couples",
      "mcp__date-planner__list_past_dates",
      "mcp__date-planner__get_date",
      "mcp__date-planner__list_dates",
      "mcp__date-planner__find_venue",
      "mcp__date-planner__detect_booking_channel",
      "mcp__date-planner__suggest_reservation_need",
      "mcp__date-planner__build_booking_link",
      "mcp__date-planner__compute_booking_window",
      "mcp__date-planner__find_google_place",
      "mcp__date-planner__resy_widget_args",
      "mcp__date-planner__get_sunset",
      "mcp__date-planner__get_forecast",
      "mcp__date-planner__estimate_travel",
      "mcp__date-planner__plan_timeline",

      "mcp__garmin__get_full_name",
      "mcp__garmin__get_user_profile",
      "mcp__garmin__get_activities",
      "mcp__garmin__get_activities_by_date",
      "mcp__garmin__get_activity",
      "mcp__garmin__get_activity_splits",
      "mcp__garmin__get_activity_exercise_sets",
      "mcp__garmin__get_training_readiness",
      "mcp__garmin__get_training_status",
      "mcp__garmin__get_hrv_data",
      "mcp__garmin__get_sleep_data",
      "mcp__garmin__get_stats",
      "mcp__garmin__get_workouts",
      "mcp__garmin__get_workout_by_id",
      "mcp__garmin__get_scheduled_workouts",
      "mcp__garmin__get_devices",
      "mcp__garmin__get_device_last_used",

      "mcp__tee-time-booker__list_courses",
      "mcp__tee-time-booker__get_course",
      "mcp__tee-time-booker__list_plans",
      "mcp__tee-time-booker__get_plan",
      "mcp__tee-time-booker__search_tee_times",
      "mcp__tee-time-booker__find_tee_times",
      "mcp__tee-time-booker__list_requests",
      "mcp__tee-time-booker__get_request",
      "mcp__tee-time-booker__list_request_runs",
      "mcp__tee-time-booker__list_runs",
      "mcp__tee-time-booker__get_run",

      "mcp__claude_ai_Google_Calendar__list_events",
      "mcp__claude_ai_Google_Calendar__get_event",
      "mcp__claude_ai_Google_Calendar__list_calendars",
      "mcp__claude_ai_Google_Calendar__suggest_time",
      "mcp__claude_ai_Gmail__search_threads",
      "mcp__claude_ai_Gmail__get_thread"
    ],
    "ask": [
      "mcp__tee-time-booker__book_plan",
      "mcp__tee-time-booker__run_request"
    ],
    "deny": [
      "Bash",
      "mcp__tee-time-booker__delete_plan",
      "mcp__claude_ai_Gmail__send_message",
      "mcp__claude_ai_Gmail__reply",
      "mcp__claude_ai_Gmail__forward"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/memory_only.py\" \"${CLAUDE_PROJECT_DIR}\""
          }
        ]
      },
      {
        "matcher": "mcp__.*([Cc]alendar).*__(delete_event|create_event|update_event)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/../date-planner/.claude/hooks/calendar_guard.py\""
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/telegram_progress.py\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
