# Copy to apps/pay-my-bills/.env and fill in. Never committed.

# --- Telegram -------------------------------------------------------------------
# From @BotFather.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (ask @userinfobot). Comma-separate several;
# every message goes to each of them.
TELEGRAM_ALLOWED_USER_IDS=

# --- Roommate -------------------------------------------------------------------
# Their name exactly as Venmo shows it in "<name> paid your $X request" emails.
ROOMMATE_NAME=Austin Will
# Their Venmo username, without the @.
ROOMMATE_VENMO=AGWill
# Optional: shown as an "or by Zelle to ..." line (there's no Zelle link to prefill).
ROOMMATE_ZELLE=
# The roommate's share of each bill, in percent of what was actually charged
# (fees included). Rent is split the same way.
SPLIT_PERCENT=50
# The whole month's rent, in dollars. The roommate's share is requested at
# 9am on the last day of each month, for the month after ("Rent November
# 2026"). Leave blank to not handle rent.
RENT_TOTAL=2900

# --- Gmail ----------------------------------------------------------------------
# The Desktop OAuth client JSON from Google Cloud, and where the sign-in token
# is kept. These are the defaults.
# GMAIL_CLIENT_SECRETS=~/.config/pay-my-bills/client_secret.json
# GMAIL_TOKEN_FILE=~/.config/pay-my-bills/token.json
# How often to check Gmail, in seconds (at least 30).
GMAIL_POLL_SECONDS=120

# --- Bills ----------------------------------------------------------------------
# SCE autopay debits this many days before the due date (due Nov 2, taken
# Oct 22). SCE doesn't email when it does, so the request goes out that day.
SCE_AUTOPAY_DAYS_BEFORE_DUE=11
# PAY_MY_BILLS_TIMEZONE=America/Los_Angeles
# A SQLite file; this is the default.
# PAY_MY_BILLS_DATABASE_URL=sqlite:////Users/you/.local/share/pay-my-bills/bills.db
