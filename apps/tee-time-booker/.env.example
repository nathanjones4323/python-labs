# --- Database -------------------------------------------------------------------
# Courses, users, booking plans/requests and the run history. A SQLite file
# for a local install: leave this blank and `python -m tee_time_booker.setup`
# writes an absolute path to one here. A relative SQLite path is opened from
# whatever directory the booker runs in.
DATABASE_URL=
# Or the Postgres in docker-compose.yml (hosted installs and CI use Postgres):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/tee_time_booker
# A Postgres for the test suite; without it the tests use a throwaway SQLite
# file. Wiped on every run.
# TEE_TIME_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/tee_time_booker_test

# --- Course logins (only the one you're booking is required) ---------------------
# Each site account row names the prefix its login is read from; the seed
# uses SOULE for Soule Park (foreUP) and GOLFNOW for GolfNow.
SOULE_EMAIL=
SOULE_PASSWORD=
GOLFNOW_EMAIL=
GOLFNOW_PASSWORD=

# --- Payment --------------------------------------------------------------------
# Soule Park (foreUP) has no card on file, so its checkout wants a card typed
# in every time. Not needed for GolfNow.
CREDIT_CARD_NUMBER=
CREDIT_CARD_EXPIRATION_MONTH=   # MM
CREDIT_CARD_EXPIRATION_YEAR=    # YY
CREDIT_CARD_CVC=
# GolfNow pays with the default card saved on the account, but its checkout
# still asks for the card's billing state and postal code. foreUP wants the
# postal code too.
CREDIT_CARD_POSTAL_CODE=
CREDIT_CARD_STATE=      # two-letter code, e.g. CA

# --- Runtime switches -----------------------------------------------------------
# Which booking plan to book: a plan id from `python -m tee_time_booker --list-plans`. Required unless passing --plan.
TEE_TIME_PLAN=
# Actually click the final submit. Leave false to dry-run up to that step.
TEE_TIME_SUBMIT_PAYMENT=false
# Run Chromium headless. Set false to watch the browser locally.
TEE_TIME_HEADLESS=true
# Where dry-run / failure screenshots and page HTML are written.
TEE_TIME_ARTIFACTS_DIR=artifacts
# Testing aid: book this date (YYYY-MM-DD) instead of the computed one, and
# don't wait for a release. Pick any date already open for booking.
TEE_TIME_TARGET_DATE=

# --- Telegram bot (python -m tee_time_booker.bot) --------------------------------
# From @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=
# Who the bot answers: numeric Telegram user ids, comma-separated (@userinfobot
# tells you yours). Everyone else is ignored.
TELEGRAM_ALLOWED_USER_IDS=
# The user (from the seed) the bot books as.
TEE_TIME_USER_EMAIL=
# The model that reads the messages and calls the booking tools; setup asks
# (`python -m tee_time_booker.setup --model` to change it later):
#   anthropic: Claude (needs ANTHROPIC_API_KEY with credits)
#   local:     a model on this machine, through Ollama (free, private)
#   openai:    any OpenAI-compatible API, e.g. a free OpenRouter model
# Left blank, a set ANTHROPIC_API_KEY means anthropic.
TEE_TIME_BOT_PROVIDER=
ANTHROPIC_API_KEY=
# For openai: the API's base URL and key (local needs neither).
TEE_TIME_BOT_BASE_URL=
TEE_TIME_BOT_API_KEY=
# The model: claude-sonnet-5-5 for anthropic, the alias setup creates
# (tee-time-booker) for local, required for openai.
TEE_TIME_BOT_MODEL=
# Optional: Claude's effort level (anthropic only), and the local Whisper
# model for voice notes (tiny.en is faster, small.en more accurate).
TEE_TIME_BOT_EFFORT=medium
TEE_TIME_WHISPER_MODEL=base.en
