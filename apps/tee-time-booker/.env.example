# --- Database -------------------------------------------------------------------
# Courses, users, booking plans/requests and the run history. For the local
# Postgres in docker-compose.yml:
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/tee_time_booker
# Used by the test suite (skipped when unset). Wiped on every run.
TEE_TIME_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/tee_time_booker_test

# --- Course logins (only the one you're booking is required) ---------------------
# Each site account row names the prefix its login is read from; the seed
# uses SOULE for Soule Park (foreUP) and GOLFNOW for GolfNow.
SOULE_EMAIL=
SOULE_PASSWORD=
GOLFNOW_EMAIL=
GOLFNOW_PASSWORD=

# --- Payment --------------------------------------------------------------------
# Soule Park (foreUP) has no card on file, so its checkout wants a card typed
# in every time. Not needed for GolfNow.
CREDIT_CARD_NUMBER=
CREDIT_CARD_EXPIRATION_MONTH=   # MM
CREDIT_CARD_EXPIRATION_YEAR=    # YY
CREDIT_CARD_CVC=
# GolfNow pays with the default card saved on the account, but its checkout
# still asks for the card's billing state and postal code. foreUP wants the
# postal code too.
CREDIT_CARD_POSTAL_CODE=
CREDIT_CARD_STATE=      # two-letter code, e.g. CA

# --- Runtime switches -----------------------------------------------------------
# Which booking plan to book: a plan id printed by `python -m tee_time_booker.seed`
# or `python -m tee_time_booker --list-plans`. Required unless passing --plan.
TEE_TIME_PLAN=
# Actually click the final submit. Leave false to dry-run up to that step.
TEE_TIME_SUBMIT_PAYMENT=false
# Run Chromium headless. Set false to watch the browser locally.
TEE_TIME_HEADLESS=true
# Where dry-run / failure screenshots and page HTML are written.
TEE_TIME_ARTIFACTS_DIR=artifacts
# Testing aid: book this date (YYYY-MM-DD) instead of the computed one, and
# don't wait for a release. Pick any date already open for booking.
TEE_TIME_TARGET_DATE=
