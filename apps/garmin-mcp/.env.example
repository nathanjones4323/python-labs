# garmin-mcp settings. Copy to .env (git-ignored) and adjust. No secrets go
# here: the password is only ever typed into `garmin-mcp-login`, and the
# session tokens it creates live in GARMIN_TOKENSTORE.

# Prefills the email prompt of `garmin-mcp-login`.
# GARMIN_EMAIL=you@example.com

# Where the session tokens live (a directory; the file inside is
# garmin_tokens.json, 0600 in a 0700 directory). Keep it outside the repo.
# GARMIN_TOKENSTORE=~/.config/garmin-mcp/tokens

# true (the default): every write tool only previews. Set to false to let
# approved writes through, then restart the server.
GARMIN_DRY_RUN=true

# How long a preview's confirmation token is valid, in seconds (30–3600).
# GARMIN_APPROVAL_TTL_SECONDS=600

# Device for push_workout_to_device when the call doesn't name one
# (see list_devices). Unset: Garmin's last-used device.
# GARMIN_DEFAULT_DEVICE_ID=

# The server log (garmin-mcp.log) and the write log (operations.jsonl).
# GARMIN_STATE_DIR=~/.local/state/garmin-mcp
# GARMIN_LOG_LEVEL=INFO

# Retries for failed reads (5xx, dropped connections), with backoff. Writes
# are never retried.
# GARMIN_READ_RETRIES=2
