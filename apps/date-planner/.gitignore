.env
# OSM extracts and the prepared OSRM graph (gigabytes).
/data/

# The root ignores every .claude/; this one is the project config (skill,
# hooks, settings) and belongs in git. Personal overrides stay local.
!/.claude/
/.claude/settings.local.json

# Date preview pages and the map tiles behind them.
/previews/

# The server log; see src/date_planner/logs.py.
/logs/

# Per-checkout overrides read after .env, e.g. the main checkout pointing
# DATABASE_URL at prod. Never copied into worktrees.
.env.local
