# Copy to apps/campsite-booker/.env and fill in. Never committed.

# --- recreation.gov -------------------------------------------------------------
# Your login. Used to fill the sign-in form (campsite-booker-login, and a hold
# whose saved session has expired). Only ever typed into recreation.gov.
RECGOV_EMAIL=
RECGOV_PASSWORD=

# --- Telegram (the watcher: campsite-booker) ------------------------------------
# A bot of its own from @BotFather: two programs can't both poll one bot, and
# pay-my-bills and the assistant already have theirs.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (ask @userinfobot). Comma-separate several;
# every alert goes to each of them.
TELEGRAM_ALLOWED_USER_IDS=
# Seconds between checks of every watch (at least 30).
CAMPSITE_POLL_SECONDS=60

# --- Paying (optional) ----------------------------------------------------------
# Paying uses the card saved in your recreation.gov account's wallet; no card
# number goes here. Leave false to dry-run: checkout goes as far as "Review and
# Confirm" and stops, and the site stays in your cart.
CAMPSITE_SUBMIT_PAYMENT=false
# The wallet sometimes asks for a saved card's last 4 digits (and expiry)
# before using it. A wrong answer counts towards a 24-hour lock, so it's tried
# once.
CAMPSITE_CARD_LAST4=
CAMPSITE_CARD_EXP_MONTH=   # MM
CAMPSITE_CARD_EXP_YEAR=    # YY
# Group size on the order, when a watch doesn't give one.
CAMPSITE_GROUP_SIZE=2
# Vehicles on the order, and the equipment to tick where a campground makes it
# mandatory (comma-separated: tent, rv, trailer, pop_up, caravan_camper_van,
# pickup_camper, large_tent_over_9_x_12).
CAMPSITE_VEHICLES=1
CAMPSITE_EQUIPMENT=tent

# --- Release days (optional) -----------------------------------------------------
# Seconds between checks while a watch's dates are going on sale (min 1).
CAMPSITE_RELEASE_POLL_SECONDS=2

# --- recreation.gov's alert emails (optional) -----------------------------------
# Your own recreation.gov availability alerts, read from Gmail as a second
# trigger: each one checks its campground at once, and the timing is logged.
# Off until you run campsite-booker-gmail-login. Seconds between looks (min
# 10); 0 turns it off.
CAMPSITE_GMAIL_POLL_SECONDS=30
# The Desktop OAuth client; by default this app's own at
# ~/.config/campsite-booker/client_secret.json, else pay-my-bills'.
# CAMPSITE_GMAIL_CLIENT_SECRETS=~/.config/pay-my-bills/client_secret.json
# CAMPSITE_GMAIL_TOKEN_FILE=~/.config/campsite-booker/gmail-token.json

# --- Optional -------------------------------------------------------------------
# Set false to watch the browser while it holds a site.
# CAMPSITE_HEADLESS=true
# Watches' "today" (arrival dates in the past are skipped).
# CAMPSITE_TIMEZONE=America/Los_Angeles
# These are the defaults:
# CAMPSITE_DATABASE_URL=sqlite:////Users/you/.local/share/campsite-booker/campsites.db
# CAMPSITE_SESSION_FILE=~/.local/share/campsite-booker/session.json
# CAMPSITE_ARTIFACTS_DIR=~/.local/share/campsite-booker/artifacts
