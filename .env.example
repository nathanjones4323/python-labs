POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# USDA FoodData Central — free key signup at https://fdc.nal.usda.gov/api-key-signup.html
# DEMO_KEY works for development (30 req/hr, 50 req/day limit)
USDA_API_KEY=DEMO_KEY

# Frontend — set to your backend URL
EXPO_PUBLIC_API_URL=http://localhost:8000

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Web client ID for browser sign-in; iOS client ID for native sign-in
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
